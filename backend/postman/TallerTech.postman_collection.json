  "item": [
{
    "name":  "auth",
    "item":  [
                 {
                     "name":  "POST Login",
                     "request":  {
                                     "method":  "POST",
                                     "auth":  {
                                                  "type":  "noauth"
                                              },
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/auth/login",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"email\":\"{{authEmail}}\",\"password\":\"{{authPassword}}\"}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.collectionVariables.set(\u0027token\u0027, \u0027\u0027);",
                                                                   "if (pm.response.code === 200) { pm.collectionVariables.set(\u0027token\u0027, pm.response.json().token); }"
                                                               ]
                                                  }
                                   }
                               ]
                 },
                 {
                     "name":  "GET Me",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/auth/me"
                                 }
                 }
             ]
},
