<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/tt_management_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBackSync" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/management_back" android:padding="12dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" app:icon="@drawable/ic_management_back" app:iconPadding="0dp" app:iconTint="@color/tt_management_text" app:cornerRadius="24dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_screen_title" android:textColor="@color/tt_management_text" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_screen_subtitle" android:textColor="@color/tt_management_text_secondary" android:textSize="14sp" android:layout_marginTop="8dp" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/tt_management_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/tt_surface" android:layout_marginTop="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_profile_sync" app:tint="@color/tt_management_brand" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_state_label" android:textColor="@color/tt_management_text_secondary" android:textSize="12sp" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/syncGeneral" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_loading" android:textColor="@color/tt_management_text" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/syncConnectivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/tt_management_text_secondary" android:textSize="14sp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/syncProblem" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/tt_management_error" android:textSize="13sp" android:visibility="gone" android:layout_marginTop="12dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/tt_management_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/tt_surface" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:padding="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:id="@+id/syncCounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/tt_management_brand" android:textSize="28sp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_pending_label" android:textColor="@color/tt_management_text_secondary" android:textSize="13sp" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:id="@+id/syncErrors" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/tt_management_error" android:textSize="28sp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_error_label" android:textColor="@color/tt_management_text_secondary" android:textSize="13sp" android:layout_marginTop="4dp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/tt_management_border" app:strokeWidth="1dp" app:cardBackgroundColor="@color/tt_surface" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_management_calendar" app:tint="@color/tt_management_accent" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_last_label" android:textColor="@color/tt_management_text" android:textSize="14sp" android:layout_marginTop="12dp" android:textStyle="bold" />
        <TextView android:id="@+id/syncLastSuccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/tt_management_text_secondary" android:textSize="13sp" android:layout_marginTop="6dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSyncNow" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="20dp" android:text="@string/sync_now_label" android:textAllCaps="false" android:textStyle="bold" app:icon="@drawable/ic_profile_sync" app:cornerRadius="14dp" app:backgroundTint="@color/management_button_background" android:textColor="@color/management_button_foreground" app:iconTint="@color/management_button_foreground" app:rippleColor="@color/tt_management_button_ripple" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
      <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_management_info" app:tint="@color/tt_management_accent" android:importantForAccessibility="no" />
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/sync_note" android:textSize="12sp" android:textColor="@color/tt_management_text_secondary" android:lineSpacingExtra="3dp" />
    </LinearLayout>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>