<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/tt_background"
  android:fillViewport="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnBackSync"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Volver"
      android:textAllCaps="false"
      app:cornerRadius="14dp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text="Sincronización"
      android:textSize="28sp"
      android:textColor="@color/tt_text_primary" />
    <TextView
      android:id="@+id/syncGeneral"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text="Consultando estado…"
      android:textSize="22sp"
      android:textColor="@color/tt_text_primary" />
    <TextView
      android:id="@+id/syncConnectivity"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text=""
      android:textSize="16sp"
      android:textColor="@color/tt_text_primary" />
    <TextView
      android:id="@+id/syncCounts"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text=""
      android:textSize="16sp"
      android:textColor="@color/tt_text_primary" />
    <TextView
      android:id="@+id/syncLastSuccess"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text=""
      android:textSize="16sp"
      android:textColor="@color/tt_text_primary" />
    <TextView
      android:id="@+id/syncProblem"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text=""
      android:textSize="16sp"
      android:textColor="@color/tt_text_primary" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnSyncNow"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Sincronizar ahora"
      android:textAllCaps="false"
      app:cornerRadius="14dp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:text="Los datos se guardan primero en este dispositivo. Sincronizar ahora también reintenta los registros con error."
      android:textSize="14sp"
      android:textColor="@color/tt_text_primary" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>