<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Encabezado -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarRegisterEquipment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Registrar equipo"
            app:subtitle="Vincula el equipo a un cliente existente"
            app:titleTextColor="@color/tt_text_primary"
            app:subtitleTextColor="@color/tt_text_secondary" />

        <!-- Cliente asociado -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentClient"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Cliente"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <AutoCompleteTextView
                android:id="@+id/etEquipmentClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tipo de equipo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentType"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tipo de equipo"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <AutoCompleteTextView
                android:id="@+id/etEquipmentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Marca -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentBrand"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Marca">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEquipmentBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Modelo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentModel"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Modelo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEquipmentModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Número de serie -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentSerial"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Número de serie">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEquipmentSerial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEquipmentDescription"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Descripción">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEquipmentDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Guardar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEquipment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar equipo"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/tt_navy"
            app:cornerRadius="14dp" />

        <!-- Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEquipment"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/tt_navy"
            app:cornerRadius="14dp"
            app:strokeColor="@color/tt_navy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="El guardado real se conectará cuando implementemos la capa de datos."
            android:textColor="@color/tt_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>