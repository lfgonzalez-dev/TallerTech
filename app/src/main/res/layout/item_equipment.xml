<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/tt_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/tt_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Tipo de dispositivo -->
        <TextView
            android:id="@+id/tvEquipmentType"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/tt_navy"
            android:gravity="center"
            android:text="PC"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Información del equipo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEquipmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dell Inspiron 15"
                android:textColor="@color/tt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEquipmentClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="María López · DL-98541"
                android:textColor="@color/tt_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Estado -->
        <TextView
            android:id="@+id/tvEquipmentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="En reparación"
            android:textColor="@color/tt_navy_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>