<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:strokeColor="@color/tt_management_border" app:strokeWidth="1dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/tt_surface" android:foreground="?attr/selectableItemBackground">
